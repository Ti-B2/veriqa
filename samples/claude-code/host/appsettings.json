{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:8080"
      },
      "Https": {
        "Url": "https://127.0.0.1:8443",
        "Certificate": {
          "Path": "REPLACE_ME/veriqa-local.pfx",
          "Password": "REPLACE_ME"
        }
      }
    }
  },
  "Veriqa": {
    "Channels": {
      "Telegram": {
        "Enabled": true,
        "BotToken": "REPLACE_ME",
        "UpdateMode": "Polling",
        "InboundVerification": "outbound_fetch"
      },
      "OutcomeNotice": {
        "DisplayIntent": "NewMessage"
      }
    },
    "MessageTemplates": {
      "outcome-receipt-confirmed": {
        "Contract": {
          "Slots": [
            {
              "Name": "app",
              "Type": "string",
              "Source": "ServerSystem"
            }
          ]
        },
        "Templates": [
          "{app}: approved ✅",
          "Approved ✅"
        ]
      },
      "outcome-receipt-declined": {
        "Contract": {
          "Slots": [
            {
              "Name": "app",
              "Type": "string",
              "Source": "ServerSystem"
            }
          ]
        },
        "Templates": [
          "{app}: declined ❌",
          "Declined ❌"
        ]
      }
    },
    "OpenIddict": {
      "Clients": [
        {
          "ClientId": "claude-code",
          "ClientSecret": "REPLACE_ME",
          "AllowClientCredentials": true,
          "AllowConfirmationTokenGrant": true,
          "AllowedScopes": [
            "openid",
            "channel"
          ],
          "IdentityMatchComparableTypes": [
            {
              "Name": "channel_user_id",
              "ClaimName": "channel_user_id",
              "Normalization": "Exact"
            }
          ],
          "MessageTemplates": {
            "agent-tool-call": {
              "Contract": {
                "Slots": [
                  {
                    "Name": "action",
                    "Type": "string",
                    "MaxLength": 64
                  },
                  {
                    "Name": "tool",
                    "Type": "string",
                    "MaxLength": 64,
                    "Required": true
                  },
                  {
                    "Name": "target",
                    "Type": "string",
                    "MaxLength": 128,
                    "Required": true
                  },
                  {
                    "Name": "project",
                    "Type": "string",
                    "MaxLength": 64
                  }
                ]
              },
              "Templates": [
                "Claude Code in {project} wants to {action}.\nCommand: {target}\nAllow it?",
                "Claude Code wants to {action}.\nCommand: {target}\nAllow it?",
                "Claude Code in {project} wants to run {tool}: {target}. Allow it?",
                "Claude Code wants to run {tool}: {target}. Allow it?"
              ]
            },
            "agent-command-start": {
              "Contract": {
                "Slots": [
                  {
                    "Name": "command",
                    "Type": "string",
                    "MaxLength": 64,
                    "Required": true
                  },
                  {
                    "Name": "arguments",
                    "Type": "string",
                    "MaxLength": 128
                  },
                  {
                    "Name": "project",
                    "Type": "string",
                    "MaxLength": 64
                  },
                  {
                    "Name": "started_by",
                    "Type": "enum",
                    "Values": [
                      "person",
                      "agent"
                    ],
                    "Required": true
                  }
                ]
              },
              "Templates": [
                "Claude Code in {project} is about to start /{command} {arguments} (started by: {started_by}). Start it?",
                "Claude Code in {project} is about to start /{command} (started by: {started_by}). Start it?",
                "Claude Code is about to start /{command} (started by: {started_by}). Start it?"
              ]
            },
            "agent-costly-run": {
              "Contract": {
                "Slots": [
                  {
                    "Name": "run",
                    "Type": "string",
                    "MaxLength": 64,
                    "Required": true
                  },
                  {
                    "Name": "input_mtok",
                    "Type": "number",
                    "Min": 0,
                    "Required": true
                  },
                  {
                    "Name": "output_mtok",
                    "Type": "number",
                    "Min": 0,
                    "Required": true
                  },
                  {
                    "Name": "cost_usd",
                    "Type": "number",
                    "Min": 0,
                    "Required": true
                  },
                  {
                    "Name": "project",
                    "Type": "string",
                    "MaxLength": 64
                  },
                  {
                    "Name": "approver",
                    "Type": "string",
                    "MaxLength": 32
                  }
                ]
              },
              "Templates": [
                "For {approver}: Claude Code in {project} wants to start {run}, estimated at {input_mtok} M input and {output_mtok} M output tokens, about {cost_usd} USD. Start it?",
                "For {approver}: Claude Code wants to start {run}, estimated at {input_mtok} M input and {output_mtok} M output tokens, about {cost_usd} USD. Start it?",
                "Claude Code in {project} wants to start {run}, estimated at {input_mtok} M input and {output_mtok} M output tokens, about {cost_usd} USD. Start it?",
                "Claude Code wants to start {run}, estimated at {input_mtok} M input and {output_mtok} M output tokens, about {cost_usd} USD. Start it?"
              ]
            },
            "agent-approver-enroll": {
              "Contract": {
                "Slots": [
                  {
                    "Name": "name",
                    "Type": "string",
                    "MaxLength": 32,
                    "Required": true
                  },
                  {
                    "Name": "project",
                    "Type": "string",
                    "MaxLength": 64
                  }
                ]
              },
              "Templates": [
                "Claude Code in {project} asks to register this messenger account as the approver \"{name}\". Confirm only if you are {name}.",
                "Claude Code asks to register this messenger account as the approver \"{name}\". Confirm only if you are {name}."
              ]
            }
          }
        }
      ]
    }
  }
}
