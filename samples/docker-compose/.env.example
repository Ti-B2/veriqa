# Veriqa Core — Sample .env file
# Copy this file to .env and fill in the values before running docker compose.
# NEVER commit a .env with real secrets to git.

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# RabbitMQ
RABBITMQ_PASSWORD=change-me-strong-password

# Public URL (no trailing slash)
WEBHOOK_BASE_URL=https://your-domain.com

# Telegram Bot (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# MAX Bot (optional)
MAX_ENABLED=false
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=

# OpenIddict X.509 certificates (Base64-encoded PFX)
# Generation: see docs/production-certificates.md
SIGNING_CERTIFICATE_BASE64=
SIGNING_CERTIFICATE_PASSWORD=
ENCRYPTION_CERTIFICATE_BASE64=
ENCRYPTION_CERTIFICATE_PASSWORD=
