{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Veriqa": {
    "Channels": {
      "Telegram": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "BotToken": "",
        "UpdateMode": "Webhook",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      "WhatsApp": {
        "Enabled": false,
        "InboundVerification": "signature"
      },
      "Max": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "BotToken": "",
        "UpdateMode": "Webhook",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      "Email": {
        "Enabled": false,
        "InboundVerification": "shared_secret"
      },
      // Where the receipt of a terminal outcome appears in the conversation. ReplacePrompt is the
      // value the product ships with, stated here explicitly so the sample shows the setting
      // instead of leaning on the default: a sign-in receipt takes the place of the message that
      // asked the question, and its buttons go away with the text they belonged to.
      "OutcomeNotice": {
        "DisplayIntent": "ReplacePrompt"
      }
    },
    // The receipts of a sign-in name the application the user is signing in to. The product ships
    // its own wordings at ByType:login:BySurface:…, and a level exhausts every step of the address
    // before the resolution drops to the level below — so a redeclaration is reached only at the
    // same address. {app} is a server slot: for a sign-in it is the DisplayName of the client. The
    // last step of each ladder uses no slot, because no slot of a receipt is guaranteed.
    "MessageTemplates": {
      "outcome-receipt-confirmed": {
        "Contract": {
          "Slots": [ { "Name": "app", "Type": "string", "Source": "ServerInitiatorContext" } ]
        },
        "ByType": {
          "login": {
            "BySurface": {
              "in-channel-messenger": {
                "Templates": [ "Signed in to {app} ✅", "Signed in ✅" ]
              },
              "in-channel-plain": {
                "Templates": [ "Signed in to {app}", "Signed in" ]
              }
            }
          }
        }
      },
      "outcome-receipt-declined": {
        "Contract": {
          "Slots": [ { "Name": "app", "Type": "string", "Source": "ServerInitiatorContext" } ]
        },
        "ByType": {
          "login": {
            "BySurface": {
              "in-channel-messenger": {
                "Templates": [ "Sign-in to {app} declined ❌", "Sign-in declined ❌" ]
              },
              "in-channel-plain": {
                "Templates": [ "Sign-in to {app} declined", "Sign-in declined" ]
              }
            }
          }
        }
      }
    },
    "TransactionEngine": {
      "TransactionTtlSeconds": 300,
      "ConfirmationFinalizationTimeoutSeconds": 30,
      "CompletedRetentionSeconds": 600,
      "CleanupIntervalSeconds": 60
    },
    "OpenIddict": {
      "Server": {
        "AccessTokenLifetimeSeconds": 3600,
        "RefreshTokenLifetimeSeconds": 1209600,
        "AuthorizationCodeLifetimeSeconds": 300
      },
      "Clients": [
        {
          "ClientId": "my-app",
          "DisplayName": "My Application",
          "AllowedRedirectUris": [ "https://localhost:7020/signin-oidc" ],
          "AllowedScopes": [ "openid", "profile", "email", "phone", "offline_access" ],
          "AllowRefreshTokens": true
        }
      ]
    },
    "AuthPageDesign": {
      "PrimaryColor": "#0088cc"
    }
  }
}
