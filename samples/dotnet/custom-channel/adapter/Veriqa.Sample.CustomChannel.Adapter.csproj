<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Sample.CustomChannel.Adapter</RootNamespace>
    <AssemblyName>Veriqa.Sample.CustomChannel.Adapter</AssemblyName>
    <!-- The sample is not a public package -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Consent to the unsettled part of the contracts surface. ChannelInboundResult — the return
         type of IChannelAdapter, so every third-party adapter meets it — is marked
         [Experimental("VERIQAEXP0001")]: it may change in a minor version, and the compiler makes
         that an error at the use site until the consuming project says it accepts the terms. This
         line is how the consent is expressed; the alternative is a #pragma around each use. Inside
         this repository the root Directory.Build.targets already suppresses the identifier for the
         whole tree, so the line is redundant here — it is kept because a copy of this project is
         meant to build outside the tree, where nothing suppresses it. See the "Versioning" section
         of the Veriqa.Core.Contracts README. -->
    <NoWarn>$(NoWarn);VERIQAEXP0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only Veriqa dependency of a third-party channel adapter: the MIT contracts package.
         Nothing from the MPL-2.0 server core is referenced here — that is the point of the SPI. -->
    <ProjectReference Include="..\..\..\..\src\core\Veriqa.Core.Contracts\Veriqa.Core.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging only. The contracts package no longer drags ASP.NET Core in, so an adapter that has
         no web surface of its own does not get one either — it declares what it actually uses. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
