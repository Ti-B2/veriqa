<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Sample.CustomChannel.Host</RootNamespace>
    <AssemblyName>Veriqa.Sample.CustomChannel.Host</AssemblyName>
    <!-- The sample is not a public package -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host embeds the Veriqa server core: registering a channel goes through
         ChannelAdapterBuilder, which lives in the MPL-2.0 package Veriqa.Core.ChannelAdapter. -->
    <ProjectReference Include="..\..\..\..\src\core\Veriqa.Core.AuthServer\Veriqa.Core.AuthServer.csproj" />
    <ProjectReference Include="..\..\..\..\src\core\Veriqa.Core.ChannelAdapter\Veriqa.Core.ChannelAdapter.csproj" />
    <ProjectReference Include="..\..\..\..\src\core\Veriqa.Core.TransactionEngine\Veriqa.Core.TransactionEngine.csproj" />
    <!-- The third-party adapter itself — an ordinary assembly built against the contracts package. -->
    <ProjectReference Include="..\adapter\Veriqa.Sample.CustomChannel.Adapter.csproj" />
  </ItemGroup>

</Project>
