<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Sample.DotNet.Inproc.LoginClient</RootNamespace>
    <AssemblyName>Veriqa.Sample.DotNet.Inproc.LoginClient</AssemblyName>
    <!-- The client sample is not a public package -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The relying party needs the standard OIDC handler and nothing from Veriqa: there is
         deliberately no ProjectReference to src/core here — the client side stays Veriqa-free. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
  </ItemGroup>

</Project>
