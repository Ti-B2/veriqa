{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Veriqa": {
    "Channels": {
      "Telegram": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "BotToken": "",
        "UpdateMode": "Webhook",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      // Where the receipt of a terminal outcome appears in the conversation. The product ships
      // ReplacePrompt — the receipt takes the place of the question. A confirmation asks about one
      // specific action, and the wording of that question IS the record of what was approved:
      // replacing it would leave the conversation with the outcome and no trace of what it was an
      // outcome of. NewMessage keeps both messages, so the request and its answer stay readable
      // side by side afterwards.
      "OutcomeNotice": {
        "DisplayIntent": "NewMessage"
      }
    },
    // The receipts of a confirmation name the application that asked for it. The product ships no
    // wording under ByType:confirmation, so the broad {kind} declaration is the step that answers
    // and rewording it here works as written. {app} is a server slot; for a confirmation the server
    // fills it with the ClientId of the calling client, not its DisplayName. The last step of each
    // ladder uses no slot, because no slot of a receipt is guaranteed.
    "MessageTemplates": {
      "outcome-receipt-confirmed": {
        "Contract": {
          "Slots": [ { "Name": "app", "Type": "string", "Source": "ServerSystem" } ]
        },
        "Templates": [ "{app}: confirmed ✅", "Confirmed ✅" ]
      },
      "outcome-receipt-declined": {
        "Contract": {
          "Slots": [ { "Name": "app", "Type": "string", "Source": "ServerSystem" } ]
        },
        "Templates": [ "{app}: declined ❌", "Declined ❌" ]
      }
    },
    "TransactionEngine": {
      "TransactionTtlSeconds": 300,
      "ConfirmationFinalizationTimeoutSeconds": 30,
      "CompletedRetentionSeconds": 600,
      "CleanupIntervalSeconds": 60
    },
    "OpenIddict": {
      "Server": {
        "AccessTokenLifetimeSeconds": 3600,
        "RefreshTokenLifetimeSeconds": 1209600,
        "AuthorizationCodeLifetimeSeconds": 300
      },
      "Clients": [
        {
          "ClientId": "support-agent",
          "ClientSecret": "",
          "AllowClientCredentials": true,
          "AllowConfirmationTokenGrant": true,
          "AllowedScopes": [
            "openid",
            "channel"
          ],
          "MessageTemplates": {
            "approve-refund": {
              "Contract": {
                "Slots": [
                  {
                    "Name": "amount",
                    "Type": "string",
                    "MaxLength": 32,
                    "Required": true
                  },
                  {
                    "Name": "order",
                    "Type": "string",
                    "MaxLength": 32,
                    "Required": true
                  },
                  {
                    "Name": "reason",
                    "Type": "string",
                    "MaxLength": 120
                  }
                ]
              },
              "Templates": [
                "The support agent wants to refund {amount} for order {order}: {reason}. Allow it?",
                "The support agent wants to refund {amount} for order {order}. Allow it?"
              ]
            }
          }
        }
      ]
    }
  },
  "AgentApprovalSample": {
    "Authority": "https://localhost:7340",
    "ClientId": "support-agent",
    "ClientSecret": ""
  }
}
