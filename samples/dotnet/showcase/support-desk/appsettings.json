{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Veriqa": {
    // The three channels the sample offers. They ship disabled with empty credentials, as every
    // sample of the gallery does: a channel switched on without its credentials fails the start,
    // so `dotnet run` would stop working out of the box. Switch on the ones you have credentials
    // for — README.md has the command — and the sign-in page offers exactly those.
    "Channels": {
      "Telegram": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "BotToken": "",
        "UpdateMode": "Webhook",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      "WhatsApp": {
        "Enabled": false,
        "InboundVerification": "signature",
        "Provider": "MetaCloudApi",
        "BusinessPhoneNumber": "",
        "MetaCloudApi": {
          "PhoneNumberId": "",
          "AccessToken": "",
          "AppSecret": "",
          "WebhookVerifyToken": "",
          "GraphApiBaseUrl": "https://graph.facebook.com",
          "GraphApiVersion": "v21.0"
        }
      },
      "Email": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "PullEnabled": true,
        "PushEnabled": false,
        "PublicBaseUrl": "https://localhost:7360",
        "TokenTtl": "00:05:00",
        "Outbound": {
          "Provider": "Smtp",
          "FromAddress": "",
          "FromName": "Helio Support",
          "Smtp": {
            "Host": "",
            "Port": 587,
            "UseSsl": true,
            "RequireStartTls": true,
            "Username": "",
            "Password": ""
          }
        }
      },
      // Where the receipt of an outcome appears. For a sign-in the question is worth nothing once
      // answered, so the receipt takes its place: ReplacePrompt, the value the product ships with,
      // stated here so the sample shows the setting. A confirmation is different — see the backend
      // client below, which states NewMessage for itself.
      "OutcomeNotice": {
        "DisplayIntent": "ReplacePrompt"
      }
    },
    // The receipts of a sign-in name the application signed in to: {app} is the DisplayName of the
    // web client. They are stated for every surface the product words a sign-in on — email-confirm-page
    // included — because a level exhausts every step of the address before the resolution drops to
    // the level below, and a surface left out here would get the bare ladder of this level.
    // The receipts of a confirmation word the outcome of the action itself, per action type, from the
    // same slot values the question was asked with. ByAction sits under ByType:confirmation because no step of
    // the lookup names an action without its transaction type. The bare ladder is what any other
    // confirmation would get. A receipt reports the decision taken in the channel, not the result of the operation:
    // a confirmation by someone other than the expected person still reads as confirmed there,
    // and the backend refuses it afterwards — hence "confirmed", not "done".
    "MessageTemplates": {
      "outcome-receipt-confirmed": {
        "Contract": {
          "Slots": [ { "Name": "app", "Type": "string", "Source": "ServerSystem" } ]
        },
        "Templates": [ "{app}: confirmed ✅", "Confirmed ✅" ],
        "ByType": {
          "login": {
            "BySurface": {
              "in-channel-messenger": {
                "Templates": [ "Sign-in to {app} confirmed ✅", "Sign-in confirmed ✅" ]
              },
              "in-channel-plain": {
                "Templates": [ "Sign-in to {app} confirmed", "Sign-in confirmed" ]
              },
              "email-confirm-page": {
                "Templates": [ "Sign-in to {app} confirmed! You can close this tab.", "Sign-in confirmed! You can close this tab." ]
              }
            }
          },
          "confirmation": {
            "ByAction": {
              "resolve-ticket": {
                "Contract": {
                  "Slots": [
                    { "Name": "ticket", "Type": "string", "MaxLength": 16 },
                    { "Name": "subject", "Type": "string", "MaxLength": 64 }
                  ]
                },
                "Templates": [ "Closing ticket {ticket} “{subject}” confirmed ✅", "Ticket closing confirmed ✅" ]
              },
              "delete-ticket": {
                "Contract": {
                  "Slots": [
                    { "Name": "ticket", "Type": "string", "MaxLength": 16 },
                    { "Name": "subject", "Type": "string", "MaxLength": 64 }
                  ]
                },
                "Templates": [ "Deleting ticket {ticket} “{subject}” confirmed ✅", "Ticket deletion confirmed ✅" ]
              }
            }
          }
        }
      },
      "outcome-receipt-declined": {
        "Contract": {
          "Slots": [ { "Name": "app", "Type": "string", "Source": "ServerSystem" } ]
        },
        "Templates": [ "{app}: declined ❌", "Declined ❌" ],
        "ByType": {
          "login": {
            "BySurface": {
              "in-channel-messenger": {
                "Templates": [ "Sign-in to {app} declined ❌", "Sign-in declined ❌" ]
              },
              "in-channel-plain": {
                "Templates": [ "Sign-in to {app} declined", "Sign-in declined" ]
              },
              "email-confirm-page": {
                "Templates": [ "Sign-in to {app} declined. You can close this tab.", "Sign-in declined. You can close this tab." ]
              }
            }
          },
          "confirmation": {
            "ByAction": {
              "resolve-ticket": {
                "Contract": {
                  "Slots": [
                    { "Name": "ticket", "Type": "string", "MaxLength": 16 },
                    { "Name": "subject", "Type": "string", "MaxLength": 64 }
                  ]
                },
                "Templates": [ "Ticket {ticket} stays open ❌", "Ticket stays open ❌" ]
              },
              "delete-ticket": {
                "Contract": {
                  "Slots": [
                    { "Name": "ticket", "Type": "string", "MaxLength": 16 },
                    { "Name": "subject", "Type": "string", "MaxLength": 64 }
                  ]
                },
                "Templates": [ "Ticket {ticket} is kept ❌", "Ticket is kept ❌" ]
              }
            }
          }
        }
      }
    },
    // One look per client: the sign-in page is opened by the web client, the page behind the shared
    // QR of a confirmation by the backend client, and each names its own record as the default. Only
    // the title differs; everything else falls through to the client and to AuthPageDesign below.
    "UiConfigurations": {
      "Records": {
        "helio-sign-in": {
          "Title": "Sign in via messenger"
        },
        "helio-ticket-action": {
          "Title": "Confirm the ticket action"
        }
      }
    },
    "TransactionEngine": {
      "TransactionTtlSeconds": 300,
      "ConfirmationFinalizationTimeoutSeconds": 30,
      "CompletedRetentionSeconds": 600,
      "CleanupIntervalSeconds": 60
    },
    "OpenIddict": {
      "Server": {
        "AccessTokenLifetimeSeconds": 3600,
        "RefreshTokenLifetimeSeconds": 1209600,
        "AuthorizationCodeLifetimeSeconds": 300
      },
      "Clients": [
        // The customer's browser. A public client (no secret), so Veriqa requires PKCE from it.
        {
          "ClientId": "helio-support-web",
          "DefaultUiConfig": "helio-sign-in",
          "AllowedUiConfigs": [ "helio-sign-in" ],
          "DisplayName": "Helio Support",
          "AllowedRedirectUris": [ "https://localhost:7360/signin-oidc" ],
          "AllowedScopes": [ "openid", "profile", "email", "phone", "channel", "avatar", "offline_access" ],
          "AllowRefreshTokens": true
        },
        // The backend half: it creates the ticket confirmations and reads their results.
        {
          "ClientId": "helio-support-backend",
          "DefaultUiConfig": "helio-ticket-action",
          "AllowedUiConfigs": [ "helio-ticket-action" ],
          "ClientSecret": "",
          "AllowClientCredentials": true,
          "AllowConfirmationTokenGrant": true,
          "AllowedScopes": [ "openid", "channel" ],
          // The confirmations are created by this client, so its entry is the level their receipt is
          // resolved at. A confirmation asks about one specific action, and the wording of that
          // question IS the record of what was approved: NewMessage keeps it and adds the receipt as
          // a message of its own, while a sign-in keeps the ReplacePrompt of the global section.
          "OutcomeNoticeDisplayIntent": "NewMessage",
          // Who a confirmation may be addressed to. One entry per channel the sample offers: the
          // claim is the same for all three, the normalisation rule is what differs. A confirmation
          // naming a type that is not declared here is refused with candidate_type_undeclared.
          "IdentityMatchComparableTypes": [
            { "Name": "telegram_user_id", "ClaimName": "channel_user_id", "Normalization": "Exact" },
            { "Name": "whatsapp_phone", "ClaimName": "channel_user_id", "Normalization": "E164Phone" },
            { "Name": "email_address", "ClaimName": "channel_user_id", "Normalization": "EmailDomainCaseFold" }
          ],
          // Closing a ticket and deleting it are different questions to the customer, so they are
          // two action types with wordings of their own rather than one type with a parameter.
          "MessageTemplates": {
            "resolve-ticket": {
              "Contract": {
                "Slots": [
                  { "Name": "ticket", "Type": "string", "MaxLength": 16, "Required": true },
                  { "Name": "subject", "Type": "string", "MaxLength": 64, "Required": true }
                ]
              },
              "Templates": [
                "Mark ticket {ticket} “{subject}” as resolved?",
                "Mark ticket {ticket} as resolved?"
              ]
            },
            "delete-ticket": {
              "Contract": {
                "Slots": [
                  { "Name": "ticket", "Type": "string", "MaxLength": 16, "Required": true },
                  { "Name": "subject", "Type": "string", "MaxLength": 64, "Required": true }
                ]
              },
              "Templates": [
                "Delete ticket {ticket} “{subject}”? This cannot be undone.",
                "Delete ticket {ticket}? This cannot be undone."
              ]
            }
          }
        }
      ]
    },
    "AuthPageDesign": {
      "PrimaryColor": "#1f6feb",
      // The row over the card: the mark of Veriqa beside the name of the desk. Without a logo and a
      // name the page shows the product's own mark alone, which is not what a sample pretending to
      // be somebody's support desk should show.
      "BrandName": "Helio",
      "LogoUrl": "/veriqa-mark.svg",
      // On a phone the page shows the channel buttons and no QR: a QR is for another device's
      // camera, and the phone is the device holding the messenger.
      "QrCode": {
        "ShowQrCode": "DesktopOnly"
      }
    }
  },
  "SupportDeskSample": {
    // Base address of the issuer this very process hosts. Behind a tunnel, set this and
    // Veriqa__OpenIddict__Server__Issuer to the public address — see README.md.
    "Authority": "https://localhost:7360",
    "WebClientId": "helio-support-web",
    "ClientId": "helio-support-backend",
    "ClientSecret": "",
    "ResolveActionType": "resolve-ticket",
    "DeleteActionType": "delete-ticket"
  }
}
