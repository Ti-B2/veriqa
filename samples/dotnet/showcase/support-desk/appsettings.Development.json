{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Veriqa": {
    "Channels": {
      // Polling needs no public address, so it is the mode for a run without a tunnel. Behind a
      // tunnel switch to Webhook and set WebhookBaseUrl/WebhookSecretToken — see README.md.
      "Telegram": {
        "Enabled": false,
        "InboundVerification": "outbound_fetch",
        "BotToken": "YOUR_TELEGRAM_BOT_TOKEN",
        "UpdateMode": "Polling",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      }
    },
    "OpenIddict": {
      // Both entries are spelled out: a configuration array is merged by INDEX, so the secret of
      // the second client has to arrive at index 1 — naming the client at index 0 keeps that
      // alignment visible instead of leaving an empty placeholder object.
      "Clients": [
        {
          "ClientId": "helio-support-web"
        },
        {
          "ClientId": "helio-support-backend",
          "ClientSecret": "development-only-sample-secret"
        }
      ]
    }
  },
  "SupportDeskSample": {
    "ClientSecret": "development-only-sample-secret"
  }
}
