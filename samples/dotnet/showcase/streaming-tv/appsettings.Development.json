{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Veriqa": {
    "Channels": {
      // Polling needs no public address, so it is the mode for a run without a tunnel. Behind a
      // tunnel switch to Webhook and set WebhookBaseUrl/WebhookSecretToken — see README.md.
      "Telegram": {
        "Enabled": false,
        "InboundVerification": "outbound_fetch",
        "BotToken": "YOUR_TELEGRAM_BOT_TOKEN",
        "UpdateMode": "Polling",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      // WhatsApp and Email are switched on HERE, in the development file, with values that are
      // deliberately not credentials: the sign-in page of a showcase run has to show what a
      // multi-channel page looks like — a strip of channels to choose from — and a page carrying one
      // channel shows nothing of the kind. Registration is all these values buy. A login started in
      // either channel CANNOT complete: the messages go to a phone number and a mailbox that do not
      // exist, and the one channel that carries a run through is Telegram. Both stay off in
      // appsettings.json, so nothing of this reaches a deployment that copies the sample.
      "WhatsApp": {
        "Enabled": true,
        "BusinessPhoneNumber": "+15550000000",
        "MetaCloudApi": {
          "PhoneNumberId": "sample-display-only",
          "AccessToken": "sample-display-only",
          "AppSecret": "sample-display-only",
          "WebhookVerifyToken": "sample-display-only"
        }
      },
      "Email": {
        "Enabled": true,
        // Push, not Pull: Pull shows an address form, and a form is not what a television offers —
        // there is no keyboard across the room. Push addresses the letter for the person, so the
        // panel carries a QR like the other two channels do. The address it points at does not
        // exist, so the letter arrives nowhere — the same shop window as WhatsApp above.
        "PullEnabled": false,
        "PushEnabled": true,
        "Inbound": {
          "InboundAddress": "signin@sample.invalid",
          // Development only: outside it the core refuses an unverified inbound letter outright.
          "VerificationPolicy": "None"
        }
      }
    },
    "OpenIddict": {
      // Both entries are spelled out: a configuration array is merged by INDEX, so the secret of
      // the second client has to arrive at index 1 — naming the client at index 0 keeps that
      // alignment visible instead of leaving an empty placeholder object.
      "Clients": [
        {
          "ClientId": "nova-stream-tv"
        },
        {
          "ClientId": "nova-stream-backend",
          "ClientSecret": "development-only-sample-secret"
        }
      ]
    }
  },
  "StreamingTvSample": {
    "ClientSecret": "development-only-sample-secret"
  }
}
