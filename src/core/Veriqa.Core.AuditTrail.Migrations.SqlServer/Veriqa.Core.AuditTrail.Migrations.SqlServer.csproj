<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Core.AuditTrail.Migrations.SqlServer</RootNamespace>
    <!-- Shipped as a package — a host taking the audit trail from NuGet cannot create the audit
         journal on SQL Server otherwise: the migrations its EF Core options name by assembly name
         live here. -->
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.AuditTrail.Migrations.SqlServer</PackageId>
    <Authors>Veriqa</Authors>
    <Description>SQL Server migrations for the Veriqa audit journal (host-referenced migrations assembly).</Description>
    <PackageTags>veriqa;authentication;audit;efcore;migrations;sqlserver</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <ItemGroup>
    <!-- Audit journal migration assembly for SQL Server: the official EF Core path for
         multi-provider — a separate migrations assembly per provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Pinned above the version the provider brings (6.x): the 6.x line depends on Azure.Identity
         and Azure.Core, the 7.x line does not, so the dependency graph stays free of Azure packages. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The migrations follow their DbContext: it lives in the EF Core satellite (the audit trail
         package carries no ORM). The context is public, so this assembly needs no access to
         internals. -->
    <ProjectReference Include="..\Veriqa.Core.AuditTrail.EntityFrameworkCore\Veriqa.Core.AuditTrail.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
