<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Satellite package — the EF Core transaction store. Keeps Microsoft.EntityFrameworkCore out
         of the core package's transitive graph: a deployment on Redis or on the in-memory store
         never receives an ORM it does not use. -->
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.TransactionEngine.EntityFrameworkCore</PackageId>
    <Authors>Veriqa</Authors>
    <Description>EF Core transaction store for the Veriqa Transaction Engine (satellite package). The provider (Npgsql etc.) and the migrations assembly belong to the host.</Description>
    <PackageTags>veriqa;authentication;transactions;efcore</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <!-- Declared inventory of the public surface (PublicAPI.*.txt + RS0016/RS0017 as errors). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\PublicApi.props" />

  <ItemGroup>
    <!-- Provider-agnostic (SPEC-001 §10.2): only the base EF Core packages. The provider package
         (Npgsql) lives in the migrations assembly and in the host. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veriqa.Core.TransactionEngine\Veriqa.Core.TransactionEngine.csproj" />
  </ItemGroup>

  <!-- No InternalsVisibleTo to migrations assemblies: TransactionDbContext is public, so a migrations
       assembly for any provider — shipped or third-party — anchors on it without a grant.
       The store entity stays in the core (the Redis store maps through it too) and is reached
       through the core's own InternalsVisibleTo to this satellite. -->

</Project>
