<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Metapackage: a package with no library of its own, only a set of dependencies (the standard
         NuGet shape — MS Docs, "Creating a metapackage"). One `dotnet add package` gives the base
         channel set, and a deployment that wants a single channel takes that channel's package
         instead. No API of its own appears at the consumer. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.BaseChannels</PackageId>
    <Authors>Veriqa</Authors>
    <Description>Veriqa base channel set — a metapackage pulling the channel contour together with the Telegram, WhatsApp and Email channels. MAX is installed separately (Veriqa.Core.ChannelAdapter.Max).</Description>
    <PackageTags>veriqa;authentication;channels;metapackage</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <!-- NU5128 fires because the package declares a dependency group without shipping a lib folder
         for it — which is exactly what a metapackage is. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <ItemGroup>
    <!-- The whole content of the package: the channel contour plus the base set of channels.
         MAX stays out deliberately — it is installed with an explicit
         `dotnet add package Veriqa.Core.ChannelAdapter.Max` (decision of 2026-08-26). -->
    <ProjectReference Include="..\Veriqa.Core.ChannelAdapter\Veriqa.Core.ChannelAdapter.csproj" />
    <ProjectReference Include="..\Veriqa.Core.ChannelAdapter.Telegram\Veriqa.Core.ChannelAdapter.Telegram.csproj" />
    <ProjectReference Include="..\Veriqa.Core.ChannelAdapter.WhatsApp\Veriqa.Core.ChannelAdapter.WhatsApp.csproj" />
    <ProjectReference Include="..\Veriqa.Core.ChannelAdapter.Email\Veriqa.Core.ChannelAdapter.Email.csproj" />
  </ItemGroup>

</Project>
