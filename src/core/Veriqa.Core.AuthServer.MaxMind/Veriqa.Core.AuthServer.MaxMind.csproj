<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Core.AuthServer.MaxMind</RootNamespace>
    <!-- Satellite package — the offline GeoIP provider of the initiator context check. Keeps
         MaxMind.GeoIP2 out of the base package's transitive graph: the .mmdb database it reads is
         not shipped with the product (GeoLite2 needs a MaxMind account and their EULA), so without
         this split every installation would carry a library only a few of them can use. -->
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.AuthServer.MaxMind</PackageId>
    <Authors>Veriqa</Authors>
    <Description>Offline MaxMind GeoIP provider for the Veriqa initiator context check (satellite package). The GeoLite2/GeoIP2 .mmdb database itself belongs to the deployment.</Description>
    <PackageTags>veriqa;authentication;geoip;maxmind</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <!-- Declared inventory of the public surface (PublicAPI.*.txt + RS0016/RS0017 as errors). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\PublicApi.props" />

  <ItemGroup>
    <PackageReference Include="MaxMind.GeoIP2" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veriqa.Core.AuthServer\Veriqa.Core.AuthServer.csproj" />
    <!-- The GeoIP settings (InitiatorGeoIpOptions) are declared by the transaction engine, and the
         provider binds against them directly, so the reference is stated where it is compiled
         against instead of riding in transitively through the auth server. -->
    <ProjectReference Include="..\Veriqa.Core.TransactionEngine\Veriqa.Core.TransactionEngine.csproj" />
  </ItemGroup>

</Project>
