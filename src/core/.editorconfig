# Public-release license headers for the Veriqa core projects.
# Default bucket for src/core/** is MPL-2.0 (server core, satellites, host, migrations).
# The MIT-licensed Contracts project overrides this via its own nested .editorconfig.
# Auto-generated files (<auto-generated>) are skipped by IDE0073 automatically.

[*.cs]
file_header_template = Copyright (c) Dmitrii Erusov\nSPDX-License-Identifier: MPL-2.0
dotnet_diagnostic.IDE0073.severity = error
