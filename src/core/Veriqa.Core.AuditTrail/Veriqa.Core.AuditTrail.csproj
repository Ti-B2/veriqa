<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Core.AuditTrail</RootNamespace>
    <!-- Satellite package — the audit trail (SPEC-011 N31): the event-bus receiver gated by
         Logging.Mode, the append-only sinks and the retention process. Structurally separable from
         the core, so it can be released on its own terms; the record model and the sink abstraction
         stay in the MIT contracts package. -->
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.AuditTrail</PackageId>
    <Authors>Veriqa</Authors>
    <Description>Veriqa audit trail — event-bus receiver, the in-process append-only store and the retention process (satellite package); the EF Core sink lives in the Veriqa.Core.AuditTrail.EntityFrameworkCore package.</Description>
    <PackageTags>veriqa;authentication;audit</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <!-- Declared inventory of the public surface (PublicAPI.*.txt + RS0016/RS0017 as errors). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\PublicApi.props" />

  <ItemGroup>
    <!-- The satellite sink sees internal types: the deletion side of a shipped sink
         (IAuditRetentionStore) is deliberately internal to this assembly — that is what tells the
         retention sweep apart from a custom sink — and the pair-of-choices flag on the builder is
         internal for the same reason. Its own DbContext grant to the migrations assembly lives in
         its csproj, together with the context. -->
    <InternalsVisibleTo Include="Veriqa.Core.AuditTrail.EntityFrameworkCore" />
    <!-- Test friends stay out of the packed assemblies: build/pack-core passes VeriqaPackaging=true. -->
    <InternalsVisibleTo Include="Veriqa.Core.AuditTrail.Tests" Condition="'$(VeriqaPackaging)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings resolution mechanism: the receiver and the retention process resolve the
         Logging axis through its public types, so the reference is explicit and does not ride in
         transitively through the transaction engine. The keys of that axis (LoggingConfigKeys) and
         the mode enum live there too, which is what lets the journal read them without depending on
         the OIDC server: declaring a key a second time is still forbidden (SPEC-011 N26), and the
         declaration together with the core binding stays with the auth server. -->
    <ProjectReference Include="..\Veriqa.Core.Configuration\Veriqa.Core.Configuration.csproj" />
    <ProjectReference Include="..\Veriqa.Core.TransactionEngine\Veriqa.Core.TransactionEngine.csproj" />
    <ProjectReference Include="..\Veriqa.Core.Contracts\Veriqa.Core.Contracts.csproj" />
  </ItemGroup>

</Project>
