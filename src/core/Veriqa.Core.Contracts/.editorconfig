# Contracts is the MIT-licensed public surface (third parties link it), so it
# overrides the MPL-2.0 header template inherited from src/core/.editorconfig.

[*.cs]
file_header_template = Copyright (c) Dmitrii Erusov\nSPDX-License-Identifier: MIT

# The free SPI is the public surface of this assembly, and the surface is declared, not implied:
# RS0016 fires on a public member missing from PublicAPI.*.txt, RS0017 on an entry with no member.
dotnet_diagnostic.RS0016.severity = error
dotnet_diagnostic.RS0017.severity = error
