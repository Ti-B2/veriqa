{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Veriqa": {
    "Channels": {
      "Telegram": {
        "Enabled": false,
        "InboundVerification": "outbound_fetch",
        "BotToken": "",
        "UpdateMode": "Polling",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      "Max": {
        "Enabled": false,
        "InboundVerification": "outbound_fetch",
        "BotToken": "",
        "UpdateMode": "Polling",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      "WhatsApp": {
        "Enabled": false,
        "InboundVerification": "signature",
        "Provider": "MetaCloudApi",
        "BusinessPhoneNumber": "",
        "MetaCloudApi": {
          "PhoneNumberId": "",
          "AccessToken": "",
          "AppSecret": "",
          "WebhookVerifyToken": "",
          "GraphApiBaseUrl": "https://graph.facebook.com",
          "GraphApiVersion": "v21.0"
        }
      },
      "Email": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "PublicBaseUrl": "",
        "PullEnabled": true,
        "PushEnabled": false,
        "TokenTtl": "00:10:00",
        "Outbound": {
          "Provider": "Smtp",
          "FromAddress": "",
          "FromName": "Veriqa",
          "Smtp": {
            "Host": "smtp.gmail.com",
            "Port": 587,
            "UseSsl": false,
            "RequireStartTls": true,
            "Username": "",
            "Password": ""
          }
        },
        "Inbound": {
          "Provider": "Webhook",
          "InboundAddress": "",
          "UsePlusAddressing": true,
          "VerificationPolicy": "None",
          "WebhookSecretToken": ""
        }
      }
    },
    "TransactionEngine": {
      "TransactionTtlSeconds": 300,
      "ConfirmationFinalizationTimeoutSeconds": 30,
      "CompletedRetentionSeconds": 600,
      "CleanupIntervalSeconds": 60
    },
    "OpenIddict": {
      "Server": {
        "AccessTokenLifetimeSeconds": 3600,
        "RefreshTokenLifetimeSeconds": 1209600,
        "AuthorizationCodeLifetimeSeconds": 300
      },
      "Clients": [
        {
          "ClientId": "veriqa-demo",
          "DisplayName": "Veriqa Demo Application",
          "AllowedRedirectUris": [ "https://localhost:7020/signin-oidc" ],
          "AllowedScopes": [ "openid", "profile", "email", "phone", "offline_access", "channel" ],
          "AllowRefreshTokens": true
        }
      ]
    }
  }
}
