{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Veriqa": {
    "Channels": {
      "Telegram": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "BotToken": "",
        "UpdateMode": "Webhook",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      "Max": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "BotToken": "",
        "UpdateMode": "Webhook",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      "WhatsApp": {
        "Enabled": false,
        "InboundVerification": "signature",
        "Provider": "MetaCloudApi",
        "BusinessPhoneNumber": "",
        "MetaCloudApi": {
          "PhoneNumberId": "",
          "AccessToken": "",
          "AppSecret": "",
          "WebhookVerifyToken": "",
          "GraphApiBaseUrl": "https://graph.facebook.com",
          "GraphApiVersion": "v21.0"
        }
      },
      "Email": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "PullEnabled": true,
        "PushEnabled": false,
        "PublicBaseUrl": "",
        "TokenTtl": "00:05:00",
        "Outbound": {
          "Provider": "Smtp",
          "FromAddress": "",
          "FromName": "Veriqa",
          "Smtp": {
            "Host": "",
            "Port": 587,
            "UseSsl": true,
            "RequireStartTls": true,
            "Username": "",
            "Password": ""
          }
        }
      }
    },
    "TransactionEngine": {
      "TransactionTtlSeconds": 300,
      "ConfirmationFinalizationTimeoutSeconds": 30,
      "CompletedRetentionSeconds": 600,
      "CleanupIntervalSeconds": 60
    },
    "OpenIddict": {
      "Database": {
        "Provider": "InMemory"
      },
      "Server": {
        "AccessTokenLifetimeSeconds": 3600,
        "RefreshTokenLifetimeSeconds": 1209600,
        "AuthorizationCodeLifetimeSeconds": 300
      },
      "Clients": []
    },
    "AuthPageDesign": {
      "Preset": "Default",
      "Theme": "Auto"
    },
    "Localization": {
      "DefaultLanguage": "en"
    }
  }
}
