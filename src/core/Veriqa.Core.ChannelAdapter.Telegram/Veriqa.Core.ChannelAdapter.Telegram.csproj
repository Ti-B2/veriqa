<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Core.ChannelAdapter.Telegram</RootNamespace>
    <!-- Satellite package — the Telegram channel. Keeps its platform SDK out of the base package's
         transitive graph, so a deployment that does not use Telegram never receives it. -->
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.ChannelAdapter.Telegram</PackageId>
    <Authors>Veriqa</Authors>
    <Description>Telegram channel adapter for Veriqa — cross-device sign-in confirmed in a Telegram bot (satellite package).</Description>
    <PackageTags>veriqa;authentication;telegram</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <!-- Declared inventory of the public surface (PublicAPI.*.txt + RS0016/RS0017 as errors). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\PublicApi.props" />

  <ItemGroup>
    <!-- The channel service tests drive this channel's own internals directly (its adapter, its bot
         information port, its client builder) — surfaces that are internal by design. The
         declaration travelled here with the types it opens up. -->
    <!-- Test friends stay out of the packed assemblies: build/pack-core passes VeriqaPackaging=true. -->
    <InternalsVisibleTo Include="Veriqa.Core.ChannelAdapter.Tests" Condition="'$(VeriqaPackaging)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.9.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veriqa.Core.ChannelAdapter\Veriqa.Core.ChannelAdapter.csproj" />
  </ItemGroup>

</Project>
